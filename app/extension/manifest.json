{
  "manifest_version": 3,
  "name": "Margot",
  "version": "0.1.0",
  "description": "Fill job applications with your Margot profile. You check everything and press submit.",
  "action": { "default_popup": "popup.html", "default_title": "Margot" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" }
}
